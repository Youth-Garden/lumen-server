NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3001

JWT_SECRET=change_me_to_a_random_32_char_string_minimum
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=change_me_to_a_random_32_char_string_minimum
JWT_REFRESH_EXPIRES_IN=2592000
COOKIE_SECRET=change_me_to_a_random_32_char_string_minimum

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumen

GOOGLE_CLIENT_ID=your-google-client-id

# Infrastructure - Upstash Redis (BullMQ)
UPSTASH_REDIS_URL=rediss://default:your-token@your-region.upstash.io:6379

# Infrastructure - Resend (Emails)
RESEND_API_KEY=re_your_api_key

# Infrastructure - Cloudflare R2 (Storage)
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-custom-domain.com
