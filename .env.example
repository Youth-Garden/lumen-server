# Application Server
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Security & Tokens
JWT_SECRET=change_me_to_a_random_32_char_string_minimum
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=change_me_to_a_random_32_char_string_minimum
JWT_REFRESH_EXPIRES_IN=2592000
COOKIE_SECRET=change_me_to_a_random_32_char_string_minimum

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/lumen

# Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Infrastructure - Upstash Redis (BullMQ / Caching)
UPSTASH_REDIS_URL=rediss://default:your-token@your-region.upstash.io:6379

# Infrastructure - Resend (Emails)
RESEND_API_KEY=re_your_api_key

# Infrastructure - Cloudflare R2 (Storage)
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=lumen-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
